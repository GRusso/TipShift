{
  "name": "tipshift",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test:core": "node --test test/tipshift-vault.test.mjs test/tipshift-roles.test.mjs test/tipshift-sdk.test.mjs",
    "check": "pnpm typecheck && pnpm test:core && pnpm build"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.7.2",
    "vite": "7.1.7"
  }
}
